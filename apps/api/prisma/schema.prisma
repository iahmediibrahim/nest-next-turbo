generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model comments {
  id        Int    @id @default(autoincrement())
  text      String
  author_id Int?   @unique
  post_id   Int?   @unique
  users     users? @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  posts     posts? @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model groups {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(50)
}

model posts {
  id        Int       @id @default(autoincrement())
  author_id Int?      @unique
  title     String    @db.VarChar(255)
  content   String
  comments  comments?
  users     users?    @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model profile_info {
  id       Int    @id @default(autoincrement())
  user_id  Int?   @unique
  metadata Json?  @default("{}")
  users    users? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                              Int              @id @default(autoincrement())
  name                                            String           @unique @db.VarChar(50)
  email                                           String           @unique @db.VarChar(255)
  password                                        String           @db.VarChar(255)
  created_at                                      DateTime?        @default(now()) @db.Timestamptz(6)
  comments                                        comments?
  posts                                           posts?
  profile_info                                    profile_info?
  users_to_groups_users_to_groups_group_idTousers users_to_groups? @relation("users_to_groups_group_idTousers")
  users_to_groups_users_to_groups_user_idTousers  users_to_groups? @relation("users_to_groups_user_idTousers")
}

model users_to_groups {
  user_id                               Int?   @unique
  group_id                              Int?   @unique
  id                                    Int    @id @default(autoincrement())
  users_users_to_groups_group_idTousers users? @relation("users_to_groups_group_idTousers", fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_users_to_groups_user_idTousers  users? @relation("users_to_groups_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
